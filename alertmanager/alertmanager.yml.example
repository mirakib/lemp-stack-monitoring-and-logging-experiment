global:
  smtp_smarthost: "smtp.example.com:587"
  smtp_from: "alerts@example.com"
  smtp_auth_username: "your-smtp-username"
  smtp_auth_password_file: /run/secrets/smtp_password
  smtp_require_tls: true

route:
  receiver: cpu-email
  group_by: [alertname, instance]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: cpu-email
      matchers:
        - alertname="CPUUsageHigh"

receivers:
  - name: cpu-email
    email_configs:
      - to: "your-email@example.com"
        send_resolved: true
